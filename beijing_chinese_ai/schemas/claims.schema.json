{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.beijing-chinese-ai/schemas/claims.schema.json",
  "title": "System Claims and Evidence Links",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "claim_id",
      "claim_text",
      "claim_type",
      "ability_ids",
      "source_ids",
      "evidence_strength",
      "notes"
    ],
    "properties": {
      "claim_id": { "type": "string", "minLength": 1 },
      "claim_text": { "type": "string", "minLength": 1 },
      "claim_type": { "type": "string", "minLength": 1 },
      "ability_ids": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^(BA0[1-4]|LU0[1-4]|RD0[1-8]|CL0[1-4]|PO0[1-4]|WR0[1-6]|OC0[1-3]|MC0[1-3]|WB0[1-3])$"
        },
        "uniqueItems": true
      },
      "source_ids": {
        "type": "array",
        "items": { "type": "string", "minLength": 1 },
        "uniqueItems": true
      },
      "evidence_strength": { "type": ["string", "null"], "minLength": 1 },
      "notes": { "type": ["string", "null"] }
    }
  }
}
