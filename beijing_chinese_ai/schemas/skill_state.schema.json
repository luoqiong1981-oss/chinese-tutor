{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.beijing-chinese-ai/schemas/skill_state.schema.json",
  "title": "Evidence-backed Student Skill State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "student_id",
    "ability_id",
    "skill_state",
    "confidence",
    "evidence_count",
    "last_evaluated_at",
    "next_review_at"
  ],
  "properties": {
    "student_id": {
      "type": "string",
      "pattern": "^STU-[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "ability_id": {
      "type": "string",
      "pattern": "^(BA0[1-4]|LU0[1-4]|RD0[1-8]|CL0[1-4]|PO0[1-4]|WR0[1-6]|OC0[1-3]|MC0[1-3]|WB0[1-3])$"
    },
    "skill_state": { "enum": ["S0", "S1", "S2", "S3", "S4", "S5", "S6"] },
    "confidence": {
      "anyOf": [
        { "type": "number", "minimum": 0, "maximum": 1 },
        { "type": "null" }
      ]
    },
    "evidence_count": {
      "type": "integer",
      "minimum": 1,
      "description": "A skill_state cannot exist before at least one real learning event."
    },
    "last_evaluated_at": { "type": "string", "format": "date-time" },
    "next_review_at": {
      "anyOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    }
  }
}
