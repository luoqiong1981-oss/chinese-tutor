{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.beijing-chinese-ai/schemas/learning_event.schema.json",
  "title": "Learning Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "session_id",
    "student_id",
    "timestamp",
    "domain_code",
    "ability_ids",
    "task_id",
    "event_type",
    "student_response",
    "evidence_used",
    "hint_level",
    "result",
    "error_type",
    "transfer_level",
    "teacher_or_ai_note"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 1 },
    "session_id": { "type": "string", "minLength": 1 },
    "student_id": {
      "type": "string",
      "pattern": "^STU-[A-Z0-9][A-Z0-9_-]{2,63}$"
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "domain_code": {
      "enum": ["BA", "LU", "RD", "CL", "PO", "WR", "OC", "MC", "WB"]
    },
    "ability_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^(BA0[1-4]|LU0[1-4]|RD0[1-8]|CL0[1-4]|PO0[1-4]|WR0[1-6]|OC0[1-3]|MC0[1-3]|WB0[1-3])$"
      },
      "uniqueItems": true
    },
    "task_id": { "type": ["string", "null"], "minLength": 1 },
    "event_type": {
      "enum": ["diagnosis", "instruction", "practice", "transfer", "feynman", "review"]
    },
    "student_response": {
      "type": ["string", "object", "array", "null"]
    },
    "evidence_used": {
      "type": "array",
      "items": { "type": "string" }
    },
    "hint_level": {
      "anyOf": [
        { "enum": ["H0", "H1", "H2", "H3", "H4", "H5", "H6"] },
        { "type": "null" }
      ]
    },
    "result": { "type": ["string", "object", "null"] },
    "error_type": { "type": ["string", "array", "null"] },
    "transfer_level": { "type": ["string", "null"], "minLength": 1 },
    "teacher_or_ai_note": { "type": ["string", "null"] }
  }
}
